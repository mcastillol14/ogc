# =============================================================================
# VARIABLES DE ENTORNO -
# =============================================================================
# 1. Copia este archivo y renómbralo a ".env"  →  cp .env.example .env
# 2. Rellena cada valor según tu entorno
# 3. NUNCA subas el archivo ".env" a git (ya está en .gitignore)
# =============================================================================


# -----------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# -----------------------------------------------------------------------------
# URL de conexión JDBC a tu base de datos PostgreSQL.
# Ejemplos:
#   Local:  DB_URL=jdbc:postgresql://localhost:5432/ogc_db
#   Neon:   DB_URL=jdbc:postgresql://<host>/neondb?sslmode=require&channel_binding=require
DB_URL=jdbc:postgresql://localhost:5432/ogc_db

# Usuario de la base de datos
DB_USERNAME=tu_usuario

# Contraseña de la base de datos
DB_PASSWORD=tu_contraseña


# -----------------------------------------------------------------------------
# JWT (JSON Web Token)
# -----------------------------------------------------------------------------
# Clave secreta para firmar los tokens JWT.
# REQUISITOS:
#   - Mínimo 32 caracteres (256 bits)
#   - Usa caracteres aleatorios (letras, números, símbolos)
# GENERAR UNA CLAVE SEGURA (elige uno):
#   PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
#   Linux/Mac:   openssl rand -base64 32
JWT_SECRET=cambia_esto_por_una_clave_segura_de_al_menos_32_caracteres
